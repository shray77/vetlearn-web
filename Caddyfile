:81 {
	# Default reverse proxy to Next.js app on :3000.
	#
	# SECURITY NOTE: previously there was a `@transform_port_query` route that
	# proxied to `localhost:{query.XTransformPort}` based on a user-supplied
	# query parameter. That was a textbook SSRF (any external client could
	# probe internal services like Redis/Postgres/SSH by passing
	# `?XTransformPort=6379`, `?XTransformPort=5432`, etc.). It has been
	# removed. If multi-port proxying is genuinely needed, configure each
	# target as an explicit named route below with a hardcoded port — never
	# derive the port from request input.

	handle {
		reverse_proxy localhost:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}
}
